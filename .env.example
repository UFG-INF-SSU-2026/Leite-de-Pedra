# Modelo do .env lido pelo docker-compose.yml. Copie para .env (fora do Git) ou
# rode docker/preparar.sh, que cria o .env com o usuário do host.

# Usuário e grupo do host (id -u / id -g): os segredos em .local/ pertencem a ele.
HOST_UID=1000
HOST_GID=1000

# AWS: só o backend usa (Rekognition e S3), com o perfil de ~/.aws.
AWS_DEFAULT_REGION=us-east-1
REKOGNITION_COLECAO=leite-de-pedra
FOTOS_BUCKET=nome-do-bucket-das-fotos
BACKEND_AWS_PROFILE=leite-de-pedra-admin

# 127.0.0.1 (padrão) só aceita conexões da própria máquina; 0.0.0.0 abre o
# backend para a rede, para o app no celular.
BACKEND_ENDERECO=127.0.0.1

# 1 = backend em HTTP, sem TLS. Só para desenvolvimento, quando o celular não
# confia na CA do projeto: senhas, tokens e fotos passam sem criptografia.
# Vazio = HTTPS (padrão).
BACKEND_SEM_TLS=
