# Produtor: envia somente telemetria.
user produtor
topic write fila/+/contagem
topic write fila/+/heartbeat

# ESP32 de sinalização: recebe o estado, mas não pode criar movimentos.
user consumidor
topic read fila/+/estado

# Processador: recebe a telemetria e é o único que emite recomendações.
user processador
topic read fila/+/contagem
topic read fila/+/validacao
topic read fila/+/heartbeat
topic write fila/+/recomendacao
topic write fila/+/estado

# Validador do navegador: publica apenas passagens de ticket.
user validador
topic write fila/+/validacao
topic read fila/+/estado

# Observador: papel estritamente de leitura.
user observador
topic read fila/#
