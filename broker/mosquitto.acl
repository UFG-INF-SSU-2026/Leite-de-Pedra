# Presença (Last Will e online ao conectar): cada usuário só escreve o próprio
# status; %u é o usuário autenticado, então ninguém se passa por outro componente.
pattern write sistema/%u/status

# Produtor: envia somente os movimentos dos sensores e o heartbeat.
user produtor
topic write fila/+/contagem
topic write fila/+/saida
topic write fila/+/heartbeat

# ESP32 de sinalização: recebe o estado e os resultados e confirma a reação
# executada; não pode criar movimentos nem resultados.
user consumidor
topic read fila/+/estado
topic read fila/+/resultado
topic write fila/+/reacao

# Processador: recebe movimentos e leituras já reconhecidas pelo backend; é o único que decide.
user processador
topic read fila/+/contagem
topic read fila/+/saida
topic read fila/+/heartbeat
topic read fila/+/leitura
topic write fila/+/recomendacao
topic write fila/+/estado
topic write fila/+/resultado
topic write sistema/processador/rejeitado

# Validador (página local da demo): só acompanha o estado e os resultados.
# As leituras agora vêm do app, pelo backend.
user validador
topic read fila/+/resultado
topic read fila/+/estado

# Backend do app: publica as leituras dos validadores logados e recebe os
# resultados que as catracas esperam. O acompanhamento ao vivo é do observador.
user backend
topic write fila/+/leitura
topic read fila/+/resultado

# Observabilidade: lê tudo e não escreve nada além do próprio status. Lê as
# leituras para mostrar cada tentativa, mas descarta a referência da foto.
user observador
topic read fila/+/+
topic read sistema/+/status
topic read sistema/+/rejeitado

# Monitor (MQTTX e depuração no host): lê tudo e não escreve nada além do
# próprio status. Usuário próprio para não derrubar a observabilidade, que
# entra como observador (o broker usa o usuário como client id).
user monitor
topic read fila/+/+
topic read sistema/+/+
